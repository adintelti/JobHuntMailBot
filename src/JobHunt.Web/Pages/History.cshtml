@page
@model HistoryModel
@{ ViewData["Title"] = "Acompanhamento"; }
<div class="eyebrow">HISTÓRICO LOCAL</div><h1>Cada envio, registrado.</h1>
<p class="intro">Veja o progresso, consulte as falhas e baixe o log de cada lote.</p>
@if (Model.Batches.Count == 0) { <section class="card"><p class="muted">Nenhum lote iniciado. Seu histórico aparecerá aqui.</p></section> }
@if (Model.Current is { } batch) {
    <section class="card" data-refresh="@(batch.Active ? "true" : "false")">
        <div class="section-title"><h2>@batch.Source <span class="badge">@batch.Status</span></h2>
            @if (batch.LogName.Length > 0) { <a asp-page-handler="Log" asp-route-id="@batch.Id">Baixar log JSONL</a> }</div>
        <p class="hint">@batch.Created.ToString("dd/MM/yyyy HH:mm:ss zzz") · @batch.Id</p>
        @if (batch.Error.Length > 0) { <p class="errors">@batch.Error</p> }
        <div class="stats">
            <div><strong>@batch.Items.Count(i => i.Status == "Sucesso")</strong><span>Sucessos</span></div>
            <div><strong>@batch.Items.Count(i => i.Status == "Falha")</strong><span>Falhas</span></div>
            <div><strong>@batch.Items.Count(i => i.Status == "Indeterminado")</strong><span>Indeterminados</span></div>
            <div><strong>@batch.Items.Count(i => i.Status is "Pendente" or "Enviando" or "Aguardando nova tentativa")</strong><span>Restantes</span></div>
        </div>
        @if (batch.Active) {
            <p class="hint">Atualização automática a cada quatro segundos. Fechar a aba mantém o lote ativo.</p>
            <form method="post" asp-page-handler="Cancel"><input type="hidden" name="id" value="@batch.Id" /><button class="secondary" type="submit">Cancelar lote</button></form>
        }
        <div class="table-wrap"><table><thead><tr><th>Email</th><th>Assunto</th><th>Resultado</th><th>Detalhes</th></tr></thead><tbody>
        @foreach (var item in batch.Items) { <tr><td>@item.Offer.Email</td><td>@item.Offer.Subject</td><td>@item.Status</td><td>@item.Detail</td></tr> }
        </tbody></table></div>
    </section>
}
@if (Model.Batches.Count > 0) {
<section class="card"><h2>Todos os lotes</h2><div class="table-wrap"><table><thead><tr><th>Data</th><th>Arquivo</th><th>Itens</th><th>Situação</th><th></th></tr></thead><tbody>
@foreach (var previous in Model.Batches) { <tr><td>@previous.Created.ToString("dd/MM/yyyy HH:mm zzz")</td><td>@previous.Source</td><td>@previous.Items.Count</td><td>@previous.Status</td><td><a asp-page="/History" asp-route-id="@previous.Id">Detalhes</a></td></tr> }
</tbody></table></div></section>
}
